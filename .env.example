# --- Which LLM runs the pipeline: auto | gemini | groq | ollama | none ---
# auto = first configured of Gemini (key), Groq (key), Ollama (OLLAMA_MODEL). none = offline heuristics only.
# `python main.py chat` and the computer-use agent are Gemini-only.
LLM_PROVIDER=auto

# --- Gemini via Vertex AI (optional; preferred over the API key when set) ---
# Service-account JSON, relative to the repo root. Keep it in secrets/ (git-ignored), never commit it.
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex-sa.json
# GOOGLE_CLOUD_PROJECT=        # defaults to project_id inside the JSON
# GOOGLE_CLOUD_LOCATION=global # use a region like us-central1 if your model needs one
# GEMINI_BACKEND=auto          # auto | vertex | api_key

# --- Gemini (API key) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Groq (optional; `python main.py check` verifies the key and lists the models you can use) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (optional; local models, `check` lists what you have downloaded via `ollama pull <name>`) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# --- Email (optional; Gmail: use an App Password, not your login password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# --- Naukri (optional; enables automatic login when the saved session expires) ---
# Without these, sign in by hand once with: python main.py login naukri
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
